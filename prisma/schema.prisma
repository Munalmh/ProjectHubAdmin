generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("member")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTickets  Ticket[]         @relation("TicketCreator")
  assignedTickets TicketAssignee[] @relation("TicketAssignee_user")
  assignmentsMade TicketAssignee[] @relation("TicketAssignee_assignedBy")
  comments        TicketComment[]
  projectMembers  ProjectMember[]
  uploadedAttachments Attachment[]
  timesheetEntries TimesheetEntry[]
  notifications    Notification[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  prefix      String    @default("PROJ")
  color       String    @default("#6366f1")
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("active")
  budgetHours Float?
  stars       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members  ProjectMember[]
  tickets  Ticket[]
  statuses TicketStatus[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model TicketStatus {
  id          String  @id @default(cuid())
  name        String
  color       String  @default("#6b7280")
  sortOrder   Int     @default(0)
  isCompleted Boolean @default(false)
  projectId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([projectId, name])
}

model TicketPriority {
  id     String @id @default(cuid())
  name   String @unique
  color  String @default("#6b7280")
  level  Int    @default(0)

  tickets Ticket[]
}

model Ticket {
  id          String    @id @default(cuid())
  title       String
  description String?
  uuid        String    @unique @default(cuid())
  projectId   String
  statusId    String
  priorityId  String?
  startDate   DateTime?
  dueDate     DateTime?
  stars       Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status   TicketStatus   @relation(fields: [statusId], references: [id])
  priority TicketPriority? @relation(fields: [priorityId], references: [id])
  createdBy User           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignees TicketAssignee[]
  comments  TicketComment[]
  attachments Attachment[]
  checklistItems ChecklistItem[]
  timesheetEntries TimesheetEntry[]
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String
  fileName     String
  fileType     String
  fileSize     Int
  url          String
  uploadedById String
  createdAt    DateTime @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id        String   @id @default(cuid())
  ticketId  String
  content   String
  isDone    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TimesheetEntry {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  date      DateTime @db.Date
  hours     Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TicketAssignee {
  id           String   @id @default(cuid())
  ticketId     String
  userId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User   @relation("TicketAssignee_user", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?  @relation("TicketAssignee_assignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([ticketId, userId])
}

model TicketComment {
  id        String   @id @default(cuid())
  content   String
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}